import pygame
import sys
import math

pygame.init()
screen = pygame.display.set_mode((800, 600))
pygame.display.set_caption("함수 연습 3단계 - 거리 측정 (return)")
clock = pygame.time.Clock()
font = pygame.font.SysFont("malgungothic", 26)

TARGET_X = 400   # 목표 지점(깃발) 위치
TARGET_Y = 300


# -------------------------------------------------
# [함수 정의]  get_distance(x1, y1, x2, y2)
#   - 지금까지의 함수(draw_tree 등)는 '그리기'만 하고 끝났다.
#   - 이 함수는 그리지 않는다. 대신 두 점 사이의 거리를 '계산해서 돌려준다'.
#   - 계산 결과를 return 으로 내보내면, 부른 쪽에서 그 값을 받아 쓸 수 있다.
#   - 즉  d = get_distance(...) 처럼, 돌려준 값이 d 에 담긴다.
# -------------------------------------------------
def get_distance(x1, y1, x2, y2):
    dx = x1 - x2
    dy = y1 - y2
    distance = math.sqrt(dx * dx + dy * dy)
    return distance


while True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

    screen.fill((10, 10, 30))

    # 플레이어 공은 마우스를 따라다닌다
    px, py = pygame.mouse.get_pos()

    # -------------------------------------------------
    # 함수를 불러서, 돌려준 '거리 값'을 d 에 받는다.
    #   d 는 평범한 숫자라, 아래에서 색을 정하거나 화면에 표시하는 데 쓸 수 있다.
    # -------------------------------------------------
    d = get_distance(px, py, TARGET_X, TARGET_Y)

    # 거리(d)에 따라 연결선 색을 정한다 (가까우면 초록, 멀면 빨강)
    if d < 150:
        line_color = (80, 255, 120)
    else:
        line_color = (255, 90, 90)

    # 목표 지점(깃발)
    pygame.draw.circle(screen, (255, 220, 90), (TARGET_X, TARGET_Y), 14)
    # 목표와 플레이어를 잇는 선
    pygame.draw.line(screen, line_color, (px, py), (TARGET_X, TARGET_Y), 2)
    # 플레이어 공
    pygame.draw.circle(screen, (120, 200, 255), (px, py), 16)

    # 돌려받은 거리 값을 화면에 표시
    screen.blit(font.render(f"거리: {int(d)}", True, (255, 255, 255)), (20, 15))

    pygame.display.flip()
    clock.tick(60)


