import pygame
import sys
import math
import random

pygame.init()
screen = pygame.display.set_mode((800, 600))
pygame.display.set_caption("반복문 연습 5단계 - 합체 시뮬레이션")
clock = pygame.time.Clock()
font = pygame.font.SysFont("malgungothic", 24)

# ==========================================
# [설정값]
# ==========================================
MERGE_DIST = 90     # 두 공의 거리가 이보다 가까우면 합쳐진다
MIN_BALLS  = 4      # 공이 이 수보다 적어지면 새 공을 뿌린다
# ==========================================

def make_ball(x=None, y=None, size=12):
    if x is None:
        x = random.randint(50, 750)
    if y is None:
        y = random.randint(50, 550)
    vx = random.choice([-3, -2, 2, 3])
    vy = random.choice([-3, -2, 2, 3])
    # 공 구조: [x, y, x속도, y속도, 크기]
    return [x, y, vx, vy, size]

balls = [make_ball() for _ in range(6)]

while True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

    screen.fill((10, 10, 30))

    # 공 이동 + 벽에 튕기기
    for ball in balls:
        ball[0] += ball[2]
        ball[1] += ball[3]
        if ball[0] < 20 or ball[0] > 780:
            ball[2] = -ball[2]
        if ball[1] < 20 or ball[1] > 580:
            ball[3] = -ball[3]

    # -------------------------------------------------
    # [이중 반복문 + 리스트 변형]  가까운 두 공을 합친다.
    #   enumerate 로 각 공의 '번호(i, j)'를 얻는다.
    #   j 가 i 보다 클 때만 비교한다 → 같은 짝을 두 번 세지 않기 위함.
    #   합칠 두 공의 번호를 removed 에 기록해 두었다가,
    #   반복이 끝난 뒤에 한꺼번에 처리한다.
    #   ( 반복 도중에 balls 에서 직접 삭제하면 순서가 꼬여 위험하다 )
    # -------------------------------------------------
    removed = set()
    new_balls = []
    for i, a in enumerate(balls):
        for j, b in enumerate(balls):
            if j <= i:
                continue
            if i in removed or j in removed:
                continue
            dx = a[0] - b[0]
            dy = a[1] - b[1]
            dist = math.sqrt(dx * dx + dy * dy)
            if dist < MERGE_DIST:
                # 두 공을 합친 '더 큰 공' 하나를 새로 만든다
                mx = (a[0] + b[0]) // 2
                my = (a[1] + b[1]) // 2
                new_size = a[4] + b[4]
                merged = make_ball(mx, my, new_size)
                new_balls.append(merged)
                removed.add(i)
                removed.add(j)

    # 합쳐지지 않고 살아남은 공 + 새로 생긴 큰 공
    survivors = [ball for k, ball in enumerate(balls) if k not in removed]
    balls = survivors + new_balls

    # 공이 너무 적어지면 새로 뿌린다
    while len(balls) < MIN_BALLS:
        balls.append(make_ball())

    # 공 그리기 (크기는 ball[4], 너무 커지지 않게 상한선)
    for ball in balls:
        r = min(ball[4], 60)
        pygame.draw.circle(screen, (r,0,0), (int(ball[0]), int(ball[1])), r)

    info = font.render(f"공 개수: {len(balls)}", True, (255, 255, 255))
    screen.blit(info, (20, 15))

    pygame.display.flip()
    clock.tick(60)


