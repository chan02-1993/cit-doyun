big_font = pygame.font.SysFont(""malgungothic"", 34)

# ==========================================
# [설정값]
# ==========================================
TARGET = 7        # 찾으려는 값
OPEN_DELAY = 20   # 한 칸을 훑는 데 걸리는 시간(프레임). 클수록 천천히.
# ==========================================

# 격자 (행 우선: 위 → 아래, 왼 → 오)
grid = [
    [3, 5, 2, 9, 4],
    [8, 1, 7, 6, 0],   # 여기(2행 3번째)에 7 이 있음
    [2, 4, 3, 5, 8],
    [7, 9, 1, 6, 2],   # 여기(4행 1번째)에도 7 이 있음
]
ROWS = len(grid)
COLS = len(grid[0])

timer = 0
reveal_count = 0   # 지금까지 훑은 칸 수 (애니메이션용)

while True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

    screen.fill((10, 10, 30))

    # -------------------------------------------------
    # 격자를 왼쪽 위부터 한 칸씩 훑으며 TARGET 을 찾는다. (이중 while)
    #   바깥 while(r) 이 '행'을, 안쪽 while(c) 이 '열'을 훑는다.
    #   ★ break 는 '안쪽 while 하나'만 빠져나온다.
    #     그래서 찾으면 found_r 에 표시해 두고,
    #     바깥 while 에서 그 표시를 보고 한 번 더 break 해야 한다.
    #   checks: 실제로 몇 칸을 열어봤는지 세는 값.
    # -------------------------------------------------
    found_r = -1
    found_c = -1
    checks = 0
    r = 0
    zzz=0
    while r < ROWS:
        c = 0
        while c < COLS:
            checks += 1
            if grid[r][c] == TARGET:
                found_r = r
                found_c = c
                zzz+=1
                          # 안쪽 while(열) 탈출
            c += 1
        if found_r != -1 and zzz ==2:      # 찾았다면
            break              # 바깥 while(행)도 탈출
        r += 1

    # 훑는 위치를 목표 칸까지만 애니메이션으로 보여주기
    if found_r >= 0:
        found_lin = found_r * COLS + found_c
    else:
        found_lin = ROWS * COLS - 1

    timer += 1
    if timer >= OPEN_DELAY:
        timer = 0
        if reveal_count < found_lin + 1:
            reveal_count += 1

    # 격자 그리기
    for r in range(ROWS):
        for c in range(COLS):
            k = r * COLS + c          # 훑는 순서상 이 칸의 번호
            x = 40 + c * 150
            y = 130 + r * 100
            revealed = k < reveal_count
            is_found = revealed and (r == found_r and c == found_c)

            if is_found:
                color = (80, 255, 120)     # 찾은 칸: 초록
            elif revealed:
                color = (120, 200, 255)    # 훑은 칸: 파랑
            else:
                color = (70, 70, 90)       # 아직 안 훑은 칸: 회색
            pygame.draw.rect(screen, color, (x, y, 120, 80))

            if revealed:
                num = big_font.render(str(grid[r][c]), True, (10, 10, 30))
                screen.blit(num, (x + 48, y + 22))

    # 안내 문구
    if reveal_count >= found_lin + 1 and found_r >= 0:
        msg = f""{TARGET} 을(를) {found_r + 1}행 {found_c + 1}열에서 찾았습니다!""
    elif reveal_count >= found_lin + 1:
        msg = f""{TARGET} 은(는) 격자에 없습니다.""
    else:
        msg = f""{TARGET} 을(를) 찾는 중...""
    screen.blit(font.render(msg, True, (255, 255, 255)), (20, 15))
    screen.blit(font.render(f""검사한 칸: {checks}칸"", True, (180, 220, 255)), (20, 50))

    pygame.display.flip()
    clock.tick(60)


