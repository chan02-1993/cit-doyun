        #   - 상자 안 값(boxes[i])이 TARGET 과 같으면,
        #     그 위치를 found_index 에 기록하고 break 로 즉시 멈춘다.
        #   - break 덕분에 목표를 찾은 뒤의 상자는 열지 않는다.
        # -------------------------------------------------
        i = 0
        while i < opened and i < len(boxes):
            if boxes[i] >= TARGET:
                found_index = i
                search_done = True
                break
            i += 1

        if opened >= len(boxes):
            search_done = True

    # 상자 그리기
    for idx, value in enumerate(boxes):
        x = 40 + idx * 95
        is_open = idx < opened            # 이미 열린 상자인가
        is_found = idx == found_index     # 목표를 찾은 상자인가

        if is_found:
            color = (80, 255, 120)        # 찾음: 초록
        elif is_open:
            color = (120, 200, 255)       # 열림: 파랑
        else:
            color = (70, 70, 90)          # 아직 안 열림: 회색

        pygame.draw.rect(screen, color, (x, 280, 80, 80))

        # 열린 상자는 안의 숫자를 보여준다
        if is_open:
            num = big_font.render(str(value), True, (10, 10, 30))
            screen.blit(num, (x + 28, 295))

    # 안내 문구
    if found_index >= 0:
        msg = f""{TARGET} 을(를) {found_index + 1}번째 상자에서 찾았습니다!""
    elif search_done:
        msg = f""{TARGET} 은(는) 상자에 없습니다.""
    else:
        msg = f""{TARGET} 을(를) 찾는 중... (연 상자: {opened}개)""
    info = font.render(msg, True, (255, 255, 255))
    screen.blit(info, (20, 15))

    pygame.display.flip()
    clock.tick(60)


